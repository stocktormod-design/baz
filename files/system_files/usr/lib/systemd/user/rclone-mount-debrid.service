[Unit]
Description=Monter Real-Debrid WebDAV som lokal mappe (%h/Games/DebridCloud)
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/.config/rclone/rclone.conf

[Service]
Type=simple
ExecStartPre=/usr/bin/mkdir -p %h/Games/DebridCloud
ExecStart=/usr/bin/rclone mount realdebrid: %h/Games/DebridCloud \
    --vfs-cache-mode=minimal \
    --dir-cache-time=1h \
    --poll-interval=15s \
    --umask=002
ExecStop=/usr/bin/fusermount3 -u %h/Games/DebridCloud
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
